{
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "__DATABASE_NAME__"
  },
  "Auth": {
    "RegistrationMode": "AdminOnly",
    "RefreshTokenLifetimeDays": 14,
    "RefreshCookieName": "__Host-refresh-token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
