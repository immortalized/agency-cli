{
  "name": "auth",
  "version": "0.2.1",
  "dependencies": [],
  "requiredCapabilities": [
    "api",
    "database"
  ],
  "replaces": [
    "compose.yaml",
    "database.migrations.json",
    "backend/__PROJECT_NAMESPACE__.slnx",
    "backend/src/__PROJECT_NAMESPACE__.Api/appsettings.json"
  ],
  "secrets": {
    "rename": [
      {
        "from": ".secrets/database-password",
        "to": ".secrets/database-bootstrap-password"
      }
    ],
    "generate": [
      ".secrets/database-migrator-password"
    ]
  },
  "packages": [
    {
      "project": "Infrastructure",
      "name": "Konscious.Security.Cryptography.Argon2",
      "version": "1.3.1"
    },
    {
      "project": "Infrastructure",
      "name": "System.IdentityModel.Tokens.Jwt",
      "version": "8.21.0"
    },
    {
      "project": "Api",
      "name": "Microsoft.AspNetCore.Authentication.JwtBearer",
      "version": "10.0.10"
    },
    {
      "project": "Infrastructure",
      "name": "Microsoft.Extensions.Options.ConfigurationExtensions",
      "version": "10.0.10"
    },
    {
      "project": "Infrastructure",
      "name": "Microsoft.Extensions.Http",
      "version": "10.0.10"
    }
  ],
  "migration": {
    "name": "AddAuthModule"
  }
}
